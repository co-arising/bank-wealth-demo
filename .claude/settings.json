{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/coarising-guard-write.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/coarising-verify-cloze.mjs --slice \"${COARISING_ACTIVE_SLICE:-}\""
          }
        ]
      }
    ]
  }
}
